# TTS API Configuration
# Copy this file to .env and add your actual API keys
# Priority: fal.ai (fast & quality) → ElevenLabs (quality) → Kokoro (local)

# fal.ai API Configuration (RECOMMENDED - Fast and High Quality)
# Get your API key from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# Available models: dia-tts, f5-tts, orpheus-tts
# Pricing: $0.04-0.05 per 1000 characters
# Fast inference, natural voices, dialogue support

# ElevenLabs API Configuration (High Quality Natural Voice)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VOICE_ID=JBFqnCBsd6RMkjVDRZzb
MODEL_ID=eleven_flash_v2_5

# ElevenLabs voices: Browse at https://elevenlabs.io/voice-library
# Models: eleven_flash_v2_5 (fastest), eleven_multilingual_v2, eleven_monolingual_v1

# xAI API Configuration (Voice Agent - WebSocket only)
# Get your API key from: https://console.x.ai
# Note: xAI currently only has Voice Agent API (WebSocket), not simple TTS
XAI_API_KEY=your_xai_api_key_here

# Note: Kokoro TTS (local) requires Python 3.11/3.12 (not 3.14)
