# ElevenLabs API Configuration
# Copy this file to .env and add your actual API key

# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID (default: Charlie - a friendly male voice)
# Browse voices at: https://elevenlabs.io/voice-library
VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Model selection
# Options: eleven_flash_v2_5 (fastest), eleven_multilingual_v2, eleven_monolingual_v1
MODEL_ID=eleven_flash_v2_5

# Priority: cloud (ElevenLabs first) or local (Kokoro first)
# Recommended: cloud (since Kokoro doesn't work with Python 3.14)
USE_CLOUD_FIRST=true
